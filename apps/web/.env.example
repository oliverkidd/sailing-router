# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional CDN (or object-storage) origin for coastline.pmtiles and depth.pmtiles.
# Leave unset to serve from same-origin /geo/ in local/dev.
# Example: https://cdn.example.com   → fetches https://cdn.example.com/geo/coastline.pmtiles
# NEXT_PUBLIC_CHART_BASE=https://cdn.example.com
